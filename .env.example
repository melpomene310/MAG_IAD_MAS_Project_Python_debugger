# OpenAI-совместимый endpoint (удалённый сервис или локальный сервер)
OPENAI_BASE_URL=http://host.docker.internal:8000/v1
OPENAI_API_KEY=changeme
MODEL=deepseek-v4.1-flash

# Цены за 1M токенов, для отчёта о стоимости (для локальной модели — 0).
# Кэшированный провайдером вход оплачивается по своему тарифу; пусто — как обычный вход.
PRICE_INPUT_PER_1M=0
PRICE_CACHED_INPUT_PER_1M=
PRICE_OUTPUT_PER_1M=0

# Таймаут одного вызова LLM (с), число повторов при 429/5xx/таймаутах, параллельность задач
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=5
LLM_MAX_CONCURRENCY=4

# Дисковый кэш ответов LLM (SQLite)
LLM_CACHE_ENABLED=1
LLM_CACHE_DIR=/app/.cache/llm

# Интерпретатор песочницы (с библиотеками AtCoder), не venv приложения
SANDBOX_PYTHON=/usr/local/bin/python
