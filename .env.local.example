# OpenAI-совместимый сервер модели, запущенный на хосте.
OPENAI_BASE_URL=http://host.docker.internal:8000/v1
OPENAI_API_KEY=local
MODEL=replace-with-local-model

PRICE_INPUT_PER_1M=0
PRICE_CACHED_INPUT_PER_1M=0
PRICE_OUTPUT_PER_1M=0

LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=0
LLM_MAX_CONCURRENCY=1
LLM_CACHE_ENABLED=1
LLM_CACHE_DIR=/app/.cache/llm
SANDBOX_PYTHON=/usr/local/bin/python
