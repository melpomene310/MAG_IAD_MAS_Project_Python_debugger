# Прямой OpenRouter; для рабочего прокси можно заменить адрес и ID модели.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=replace-with-key
MODEL=deepseek/deepseek-v4.1-flash

# Проверяйте тарифы модели перед платным экспериментом.
PRICE_INPUT_PER_1M=0.13
PRICE_CACHED_INPUT_PER_1M=0.0026
PRICE_OUTPUT_PER_1M=0.52

LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=0
LLM_MAX_CONCURRENCY=1
LLM_CACHE_ENABLED=1
LLM_CACHE_DIR=/app/.cache/llm
SANDBOX_PYTHON=/usr/local/bin/python
